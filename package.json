{
  "name": "smartss-landing-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "DIST_DIR=dist bun --watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "bun build server/index.ts --target=bun --minify --outfile=dist-server/index.js",
    "start": "bun server/index.ts",
    "test": "bun test server",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "lenis": "^1.3.27",
    "motion": "^14.9.0",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
